# ─────────────────────────────────────────────────────────────
# WhatsApp AI Spare Parts — Environment Variables Template
# Copy this file to .env and fill in your real values
# ─────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────
APP_ENV=development          # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── Database (PostgreSQL) ─────────────────────────────────────
DATABASE_URL=postgresql+psycopg://spareuser:sparepass@localhost:5432/spareparts
# For sync operations (Alembic):
SYNC_DATABASE_URL=postgresql://spareuser:sparepass@localhost:5432/spareparts

# ── WhatsApp Cloud API ────────────────────────────────────────
# Get these from: https://developers.facebook.com → your App → WhatsApp → API Setup
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_API_VERSION=v19.0

# ── Google Gemini AI ──────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── YouTube Data API v3 ───────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs → YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_MAX_RESULTS=3

# ── Redis (for background task queue) ────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ──────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-string
ADMIN_API_KEY=change-me-to-a-strong-admin-api-key
